# Copy to .env.local for local dev (optional).
# macOS: backend runs on 5001 because AirPlay Receiver occupies :5000.
VITE_API_URL=http://127.0.0.1:5001

# For a Vercel build set VITE_API_URL to a publicly reachable backend, e.g. a
# tunnel to the machine running PX4 SITL:
#   cloudflared tunnel --url http://127.0.0.1:5001
#   VITE_API_URL=https://<random>.trycloudflare.com
# Only the dashboard can run on Vercel: the backend needs a long-lived
# WebSocket, a mavsdk_server child process and UDP to PX4, none of which work
# on serverless functions.
