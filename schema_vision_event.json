{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vision Event",
  "description": "Object detection event with GPS coordinates for CV MVP",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "class_name",
    "confidence",
    "bbox",
    "latitude",
    "longitude",
    "snapshot_url",
    "source_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC when event was created"
    },
    "class_name": {
      "type": "string",
      "enum": ["Person", "Car", "Truck_Machinery"],
      "description": "Detected object class"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Detection confidence (0.0-1.0)"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer"
      },
      "description": "Bounding box [x1, y1, x2, y2] in frame pixels"
    },
    "latitude": {
      "type": "number",
      "description": "Estimated latitude of object center"
    },
    "longitude": {
      "type": "number",
      "description": "Estimated longitude of object center"
    },
    "snapshot_url": {
      "type": "string",
      "description": "URL or path to JPEG crop with bbox"
    },
    "source_id": {
      "type": "string",
      "description": "Source identifier (e.g., 'local_file', 'rtsp://...')"
    },
    "processing_latency_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional: frame received to alert created in milliseconds"
    },
    "track_id": {
      "type": "string",
      "description": "Optional: internal deduplication track ID"
    }
  }
}
